<%
  var here = '/' + String(page.path || '').replace(/index\.html$/, '');
  var hoverZone = theme.nav.hover_zone || 90;
  var pinAfter = theme.nav.pin_after || 260;
%>
<!-- 鼠标进入这条不可见的顶部感应带，导航才滑出 -->
<div class="nav-zone" style="height:<%= hoverZone %>px" aria-hidden="true"></div>

<header class="site-nav" id="site-nav" data-pin-after="<%= pinAfter %>">
  <div class="nav-inner">
    <a class="nav-brand" href="<%- url_for('/') %>" aria-label="<%= config.title %>">
      <span class="seal" aria-hidden="true">九</span>
      <span class="brand-text">
        <span class="brand-mark"><%- partial('_partial/wordmark') %></span>
        <% if (config.subtitle) { %><span class="brand-sub"><%= config.subtitle %></span><% } %>
      </span>
    </a>

    <nav class="nav-links" aria-label="主导航">
      <% (theme.nav.menu || []).forEach(function (item) { %>
        <a class="nav-link<%= item.url === here ? ' is-active' : '' %>" href="<%- url_for(item.url) %>">
          <span class="nav-link-cn"><%= item.name %></span>
          <% if (item.en) { %><span class="nav-link-en"><%= item.en %></span><% } %>
        </a>
      <% }); %>
    </nav>

    <% if (theme.nav.meta) { %><span class="nav-meta"><%= theme.nav.meta %></span><% } %>

    <!-- 昼夜模式：自动 / 日间 / 夜间 三态循环 -->
    <button class="mode-toggle" id="mode-toggle" type="button" data-mode="auto"
            title="切换昼夜模式（自动 / 日间 / 夜间）">
      <span class="mode-icon" aria-hidden="true"></span>
      <span class="mode-label" id="mode-label">自动</span>
    </button>

    <button class="nav-toggle" id="nav-toggle" aria-label="展开菜单" aria-expanded="false">
      <span></span><span></span>
    </button>
  </div>
</header>
