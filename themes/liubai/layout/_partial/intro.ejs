<%
  var it = theme.intro || {};
  var introSub = it.subtitle || config.subtitle || '';
  var display = it.display || '';
%>
<div class="intro" id="intro" role="dialog" aria-modal="true" aria-label="进入站点">
  <div class="intro-panel intro-panel-top" aria-hidden="true"></div>
  <div class="intro-panel intro-panel-bottom" aria-hidden="true"></div>

  <!-- ── 手绘背景：抽象技术图形（鹰角式平面语言）──────────────────────
       切角面板 + 同心断弧 + 刻度尺 + 斜向虚线带 + 十字定位标记
       天体（日 / 月）与全部颜色由 html[data-daypart] 驱动 -->
  <div class="intro-art" aria-hidden="true">
    <svg class="art" viewBox="0 0 1600 900" preserveAspectRatio="xMidYMid slice">
      <rect class="art-sky" width="1600" height="900"/>

      <path class="art-panel" d="M1188 0 H1600 V392 L1560 432 H1188 L1148 392 V40 Z"/>
      <path class="art-panel" d="M0 632 H286 L326 672 V900 H0 Z"/>

      <g class="art-arcs">
        <circle cx="176" cy="1168" r="520"/>
        <circle cx="176" cy="1168" r="700"/>
        <circle cx="176" cy="1168" r="880"/>
        <circle cx="176" cy="1168" r="1060"/>
      </g>

      <g class="art-band">
        <line x1="-40" y1="212" x2="1640" y2="58"/>
        <line x1="-40" y1="232" x2="1640" y2="78"/>
      </g>

      <g class="art-ruler">
        <line class="art-ruler-base" x1="0" y1="848" x2="1600" y2="848"/>
        <% for (var tx = 0; tx <= 1600; tx += 40) { %>
          <line class="art-tick" x1="<%= tx %>" y1="838" x2="<%= tx %>" y2="848"/>
        <% } %>
        <% for (var Tx = 0; Tx <= 1600; Tx += 200) { %>
          <line class="art-tick-major" x1="<%= Tx %>" y1="826" x2="<%= Tx %>" y2="848"/>
        <% } %>
      </g>

      <g class="art-vscale">
        <line class="art-ruler-base" x1="92" y1="120" x2="92" y2="560"/>
        <% for (var ty = 120; ty <= 560; ty += 40) { %>
          <line class="art-tick" x1="84" y1="<%= ty %>" x2="92" y2="<%= ty %>"/>
        <% } %>
      </g>

      <g class="art-marks">
        <path d="M352 168 h22 M363 157 v22"/>
        <path d="M1424 676 h22 M1435 665 v22"/>
      </g>

      <!-- 天体：白天是日，夜晚是月。
           写实光照：径向渐变当受光面，外面再套一层模糊光晕 -->
      <defs>
        <radialGradient id="discGrad" cx="36%" cy="31%" r="76%">
          <stop class="gstop-hi"  offset="0%"/>
          <stop class="gstop-mid" offset="54%"/>
          <stop class="gstop-lo"  offset="100%"/>
        </radialGradient>
      </defs>

      <g class="art-disc">
        <circle class="art-disc-glow" cx="1198" cy="284" r="126"/>
        <circle class="art-disc-body" cx="1198" cy="284" r="74" fill="url(#discGrad)"/>
        <path class="art-disc-ring" d="M1198 164 A120 120 0 0 1 1318 284"/>
        <path class="art-disc-ring" d="M1198 404 A120 120 0 0 1 1078 284"/>
        <circle class="art-moon-shade" cx="1168" cy="266" r="72"/>
      </g>
    </svg>
  </div>

  <div class="intro-stage">
    <span class="intro-bracket tl" aria-hidden="true"></span>
    <span class="intro-bracket tr" aria-hidden="true"></span>
    <span class="intro-bracket bl" aria-hidden="true"></span>
    <span class="intro-bracket br" aria-hidden="true"></span>

    <div class="intro-core">
      <% if (it.greeting) { %><div class="intro-greet" id="intro-greet"></div><% } %>

      <div class="intro-seal" aria-hidden="true"><span>九</span></div>

      <% if (display) { %>
      <div class="intro-display" aria-hidden="true">
        <% display.split('').forEach(function (ch, i) { %><%- partial('_partial/glyph', { ch: ch, i: i }) %><% }); %>
      </div>
      <% } %>

      <div class="intro-titles">
        <div class="intro-wordmark"><%- partial('_partial/wordmark') %></div>
        <% if (introSub) { %><div class="intro-sub"><%= introSub %></div><% } %>
        <% if (it.latin) { %><div class="intro-latin"><%= it.latin %></div><% } %>
      </div>

      <div class="intro-line" aria-hidden="true"><i></i></div>

      <button class="intro-enter" id="intro-enter" type="button">
        <span class="intro-enter-cn"><%= it.prompt || '点击进入' %></span>
        <% if (it.enter_label) { %><span class="intro-enter-en"><%= it.enter_label %></span><% } %>
        <span class="intro-enter-ring" aria-hidden="true"></span>
      </button>
    </div>

    <div class="intro-status">
      <span><%= it.status_left || '' %></span>
      <span class="intro-status-mid" id="intro-clock" aria-hidden="true">--:--</span>
      <span><%= it.status_right || '' %></span>
    </div>
  </div>

  <!-- ── 退场动画：扫描线 → 切角幕布横向铺开 → 淡出交还首页 ───────────── -->
  <div class="intro-veil" aria-hidden="true">
    <span class="veil-scan"></span>
  </div>
</div>
