<header class="post-head">
  <div class="post-meta">
    <time datetime="<%- date_xml(page.date) %>"><%= date(page.date, 'YYYY-MM-DD') %></time>
    <% if (page.categories && page.categories.length) { %>
      <span class="sep">/</span>
      <% page.categories.forEach(function (c) { %><a href="<%- url_for(c.path) %>"><%= c.name %></a><% }); %>
    <% } %>
  </div>
  <h1 class="post-h1"><%= page.title %></h1>
  <% if (page.tags && page.tags.length) { %>
    <div class="post-tags">
      <% page.tags.forEach(function (t) { %><a href="<%- url_for(t.path) %>">#<%= t.name %></a><% }); %>
    </div>
  <% } %>
</header>

<div class="prose" id="prose">
  <%- page.content %>
</div>

<% if (page.prev || page.next) { %>
<nav class="post-nav" aria-label="相邻文章">
  <% if (page.prev) { %>
    <a class="post-nav-item prev" href="<%- url_for(page.prev.path) %>">
      <span class="post-nav-label">← 上一篇</span>
      <span class="post-nav-title"><%= page.prev.title %></span>
    </a>
  <% } else { %><span></span><% } %>
  <% if (page.next) { %>
    <a class="post-nav-item next" href="<%- url_for(page.next.path) %>">
      <span class="post-nav-label">下一篇 →</span>
      <span class="post-nav-title"><%= page.next.title %></span>
    </a>
  <% } %>
</nav>
<% } %>
